# Server-only. For managed PostgreSQL, use a pooled URL and include the provider's
# TLS options (for Neon, preserve sslmode=require and any provider URL parameters).
DATABASE_URL=
# Direct, unpooled connection to the same database for Prisma migrations.
DIRECT_URL=
# Exact canonical HTTP(S) origin, no path, e.g. http://localhost:3000 locally.
APP_URL=http://localhost:3000
# Random secret of at least 32 characters. Generate with openssl rand -hex 32.
BETTER_AUTH_SECRET=

# Optional Resend email alerts. All three are needed to enable sending.
RESEND_API_KEY=
NOTIFICATION_FROM=
NOTIFICATION_TO=

# Local Docker Compose only. Use URL-safe hex from openssl rand -hex 24.
LOCAL_DB_PASSWORD=

# Automated tests only. Must identify a dedicated disposable *_test database.
# Set these privately in your shell or local test configuration.
TEST_DATABASE_URL=
TEST_DIRECT_URL=
